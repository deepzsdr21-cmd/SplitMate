// ===============================================================
// Assumed data model
// ===============================================================
//
// groups/{groupId}
//   name: string (required, 1–70 chars)
//   ownerUid: string (required, immutable; authenticated creator UID)
//   inviteCode: string (required, 36 lowercase hex chars)
//   createdAt: timestamp (required, server timestamp)
//
// groups/{groupId}/members/{uid}
//   uid: string (required; must match document ID and authenticated UID)
//   name: string (required, 1–50 chars)
//   joinedAt: timestamp (required, server timestamp)
//   inviteCode: string (required; must match the parent group's invite code)
//
// groups/{groupId}/expenses/{expenseId}
//   paidBy: string (required, 1–50 chars)
//   amount: number (required, > 0 and <= 100,000,000)
//   description: string (required, 1–100 chars)
//   splitWith: string (required, "everyone" or a name up to 50 chars)
//   createdBy: string (required, immutable; authenticated creator UID)
//   createdAt: timestamp (required, server timestamp)
//
// Group metadata and expense/member data are readable by group members.
// A new member may read only their own membership document before joining;
// its create rule validates the invite code before granting membership.
// There are no global collection queries and no edit/delete UI for expenses.
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
    }

    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function isValidGroup(data) {
      return hasExactFields(data, ['name', 'ownerUid', 'inviteCode', 'createdAt']) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 70 &&
        data.ownerUid is string &&
        data.inviteCode is string &&
        data.inviteCode.matches('^[a-f0-9]{36}$') &&
        data.createdAt is timestamp;
    }

    function isValidMember(data, uid) {
      return hasExactFields(data, ['uid', 'name', 'joinedAt', 'inviteCode']) &&
        data.uid is string &&
        data.uid == uid &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 50 &&
        data.joinedAt is timestamp &&
        data.inviteCode is string &&
        data.inviteCode.matches('^[a-f0-9]{36}$');
    }

    function isValidExpense(data) {
      return hasExactFields(data, ['paidBy', 'amount', 'description', 'splitWith', 'createdBy', 'createdAt']) &&
        data.paidBy is string &&
        data.paidBy.size() > 0 &&
        data.paidBy.size() <= 50 &&
        data.amount is number &&
        data.amount > 0 &&
        data.amount <= 100000000 &&
        data.description is string &&
        data.description.size() > 0 &&
        data.description.size() <= 100 &&
        data.splitWith is list &&
        data.splitWith.size() > 0 &&
        data.splitWith.size() <= 100 &&
        data.createdBy is string &&
        data.createdAt is timestamp;
    }

    match /groups/{groupId} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        isValidGroup(request.resource.data);

      // Invite codes are confidential: members may read group data after joining, and the creator may read their own category.
      allow get: if isMember(groupId) || isGroupOwner(groupId);
      allow list: if false;

      allow update: if isGroupOwner(groupId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
        isValidGroup(request.resource.data);
      allow delete: if false;

      match /members/{uid} {
        // Read of one's own missing membership document is needed to attempt a join.
        allow get: if signedIn() && (request.auth.uid == uid || isMember(groupId));
        allow list: if isMember(groupId);

        allow create: if signedIn() &&
          request.auth.uid == uid &&
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          isValidMember(request.resource.data, uid) &&
          request.resource.data.inviteCode ==
            get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode;

        // Membership identity, invite code, and join timestamp are immutable.
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow get, list: if isMember(groupId);
        allow create: if isMember(groupId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.paidBy == request.auth.uid &&
          isValidExpense(request.resource.data);
        // The app has no expense edit or delete controls.
        allow update, delete: if false;
      }
    }
  }
}
