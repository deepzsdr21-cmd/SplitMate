// ===============================================================
// Assumed data model
// ===============================================================
//
// groups/{groupId}
//   name: string (1–70 chars)
//   ownerUid: string (immutable creator UID)
//   inviteCode: string (36 lowercase hex chars)
//   memberUids: list<string> (up to 100 authenticated members)
//   participantIds: list<string> (up to 100 participants, including offline guests)
//   createdAt: timestamp
//
// groups/{groupId}/members/{uid}
//   uid: string matching document ID and authenticated UID
//   name: string (1–50 chars)
//   joinedAt: timestamp
//   inviteCode: string matching the parent group
//
// groups/{groupId}/participants/{participantId}
//   name: string (1–50 chars), createdBy: authenticated UID, createdAt: timestamp
//   linkedUid: optional authenticated UID for a self-joined participant
//
// groups/{groupId}/expenses/{expenseId}
//   paidBy: participant ID selected by a category member
//   amount: number (> 0 and <= 100,000,000)
//   description: string (1–100 chars)
//   splitWith: map keyed by member UID, with one entry per selected participant; adjustable by any member
//   createdBy: authenticated UID
//   createdAt: timestamp
//
// Existing categories may also contain the legacy ownerName field, and older
// expenses may use string splitWith values. New writes use the schema above.
// Reads require group membership (or creator access to group metadata).
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'inviteCode', 'createdAt']) &&
        data.keys().hasOnly(['name', 'ownerUid', 'ownerName', 'inviteCode', 'memberUids', 'participantIds', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 70 &&
        data.ownerUid is string &&
        data.inviteCode is string && data.inviteCode.matches('^[a-f0-9]{36}$') &&
        data.createdAt is timestamp &&
        (!('ownerName' in data) ||
          (data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 50)) &&
        (!('memberUids' in data) ||
          (data.memberUids is list && data.memberUids.size() <= 100)) &&
        (!('participantIds' in data) ||
          (data.participantIds is list && data.participantIds.size() <= 100));
    }

    function isValidMember(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'joinedAt', 'inviteCode']) &&
        data.keys().hasOnly(['uid', 'name', 'joinedAt', 'inviteCode']) &&
        data.uid is string && data.uid == uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.joinedAt is timestamp &&
        data.inviteCode is string && data.inviteCode.matches('^[a-f0-9]{36}$');
    }

    function isValidParticipant(data, participantId) {
      return data.keys().hasAll(['name', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'linkedUid']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.createdBy == request.auth.uid &&
        data.createdAt is timestamp &&
        (!('linkedUid' in data) ||
          (data.linkedUid is string && data.linkedUid == participantId));
    }

    function isMemberAfter(groupId) {
      return isMember(groupId) ||
        existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isValidExpense(data, groupId) {
      return data.keys().hasAll(['paidBy', 'amount', 'description', 'splitWith', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['paidBy', 'amount', 'description', 'splitWith', 'createdBy', 'createdAt']) &&
        data.paidBy is string && data.paidBy.size() > 0 && data.paidBy.size() <= 128 &&
        data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 100 &&
        data.createdBy is string && data.createdAt is timestamp &&
        data.splitWith is map &&
        data.splitWith.keys().size() > 0 && data.splitWith.keys().size() <= 100 &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.participantIds.hasAny([data.paidBy]) &&
        data.splitWith.keys().hasOnly(
          get(/databases/$(database)/documents/groups/$(groupId)).data.participantIds
        );
    }

    function isJoining(groupId) {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'participantIds']) &&
        request.resource.data.memberUids is list &&
        request.resource.data.participantIds is list &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1 &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
        request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        request.resource.data.participantIds.hasAny([request.auth.uid]) &&
        !resource.data.memberUids.hasAny([request.auth.uid]) &&
        !resource.data.participantIds.hasAny([request.auth.uid]) &&
        getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.inviteCode == resource.data.inviteCode &&
        getAfter(/databases/$(database)/documents/groups/$(groupId)/participants/$(request.auth.uid)).data.linkedUid == request.auth.uid &&
        isValidGroup(request.resource.data);
    }

    function isAddingParticipant(groupId) {
      let newId = request.resource.data.participantIds[resource.data.participantIds.size()];
      return isMember(groupId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']) &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1 &&
        request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
        getAfter(/databases/$(database)/documents/groups/$(groupId)/participants/$(newId)).data.createdBy == request.auth.uid &&
        isValidGroup(request.resource.data);
    }

    function isMigratingParticipantRoster(groupId) {
      return isMember(groupId) &&
        !('participantIds' in resource.data) &&
        resource.data.memberUids is list &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']) &&
        request.resource.data.participantIds == resource.data.memberUids &&
        isValidGroup(request.resource.data);
    }

    match /groups/{groupId} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids == [] &&
        request.resource.data.participantIds == [] &&
        isValidGroup(request.resource.data);

      allow get: if isMember(groupId) || isGroupOwner(groupId);
      allow list: if false;

      allow update: if (
          isGroupOwner(groupId) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          isValidGroup(request.resource.data)
        ) || isJoining(groupId) || isAddingParticipant(groupId) || isMigratingParticipantRoster(groupId);
      allow delete: if isGroupOwner(groupId);

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isMember(groupId) || isGroupOwner(groupId));
        allow list: if isMember(groupId) || isGroupOwner(groupId);

        allow create: if signedIn() &&
          request.auth.uid == uid &&
          exists(/databases/$(database)/documents/groups/$(groupId)) &&
          isValidMember(request.resource.data, uid) &&
          request.resource.data.inviteCode ==
            get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode;

        allow update: if false;
        allow delete: if isGroupOwner(groupId);
      }

      match /participants/{participantId} {
        allow get, list: if isMember(groupId) || isGroupOwner(groupId);
        allow create: if isMemberAfter(groupId) &&
          isValidParticipant(request.resource.data, participantId);
        allow update: if false;
        allow delete: if isGroupOwner(groupId);
      }

      match /expenses/{expenseId} {
        allow get, list: if isMember(groupId) || isGroupOwner(groupId);
        allow create: if isMember(groupId) &&
          request.resource.data.createdBy == request.auth.uid &&
          isValidExpense(request.resource.data, groupId);
        allow update: if isMember(groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['splitWith']) &&
          isValidExpense(request.resource.data, groupId);
        allow delete: if isGroupOwner(groupId);
      }
    }
  }
}